PORT=3000
SOLANA_RPC_URL=https://api.devnet.solana.com
INDEXER_ENABLED=true
INDEXER_POLL_SECONDS=10
# Optional: mock reporters default to INDEXER_ENABLED and poll every 60 seconds.
# MOCK_REPORTER_ENABLED=true
# MOCK_REPORTER_POLL_SECONDS=60
INDEXER_START_AT=2026-10-04T00:00:00Z
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5468/treetino_future_of_finance

# Set a stable random secret (at least 32 bytes); required in production.
# Generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_JWT_SECRET=
AUTH_ORIGIN=http://localhost:5173

# MoonPay sandbox only. Reuse test keys from the MoonPay partner dashboard.
# MOONPAY_PUBLIC_KEY=pk_test_...
# MOONPAY_SECRET_KEY=sk_test_...
# PAYMENTS_RECONCILE_ENABLED=true
